<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HeavyCaravans</RootNamespace>
    <AssemblyName>HeavyCaravans</AssemblyName>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Repo-tracked module source (SubModule.xml, ModuleData) - copied into the actual game
         install by CopyToModule below. See Directory.Build.props for why this is a copy, not a
         symlink/junction, into the game's Modules folder. -->
    <ModuleSourceDir>$(MSBuildThisFileDirectory)..\..\Modules\HeavyCaravans\</ModuleSourceDir>
    <GameModuleDir>$(BannerlordModulesDir)HeavyCaravans\</GameModuleDir>
    <GameModuleBinDir>$(GameModuleDir)bin\Win64_Shipping_Client\</GameModuleBinDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled privately (Copy Local) so HeavyCaravans works standalone, without depending on
         another mod's shared Harmony host. TAOM.Dependencies redirects bundled Harmony copies
         to its own canonical instance via AssemblyResolve when TAOM is present, so this is safe
         to coexist with TAOM/Coop too. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordBinDir)TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordBinDir)TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordBinDir)TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(BannerlordBinDir)TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordBinDir)TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordBinDir)TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.SaveSystem">
      <HintPath>$(BannerlordBinDir)TaleWorlds.SaveSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Deploys the module straight into the real game install (bin output + the repo-tracked
    SubModule.xml/ModuleData) so Bannerlord and the Steam Workshop uploader both see a complete,
    independent Modules/HeavyCaravans folder - no symlink/junction involved, see
    Directory.Build.props. Re-run on every build, so the repo stays the only thing you actually edit.
  -->
  <Target Name="CopyToModule" AfterTargets="Build">
    <ItemGroup>
      <ModuleBinFiles Include="$(TargetDir)HeavyCaravans.dll" />
      <ModuleBinFiles Include="$(TargetDir)HeavyCaravans.pdb" Condition="Exists('$(TargetDir)HeavyCaravans.pdb')" />
      <ModuleBinFiles Include="$(TargetDir)0Harmony.dll" Condition="Exists('$(TargetDir)0Harmony.dll')" />
      <ModuleDataFiles Include="$(ModuleSourceDir)ModuleData\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(GameModuleBinDir)" Condition="!Exists('$(GameModuleBinDir)')" />
    <Copy SourceFiles="@(ModuleBinFiles)" DestinationFolder="$(GameModuleBinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModuleSourceDir)SubModule.xml" DestinationFolder="$(GameModuleDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModuleDataFiles)" DestinationFolder="$(GameModuleDir)ModuleData\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(ModuleDataFiles)' != ''" />
  </Target>

</Project>
